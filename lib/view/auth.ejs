<!DOCTYPE html>
<html>

<head>
  <title>Authentication - NDA</title>
  <link rel="icon" type="image/icon" href="../images?name=nda_logo.png" />
  <style>
    body {
      /* background-color: antiquewhite; */
      font-family: sans-serif;
    }

    .card {
      background-color: #fff;
      border-radius: 10px;
      max-width: 100%;
      margin: 20px;
      border: 2px solid #d4d4d4;
      padding: 10px 20px;
    }

    ul {
      list-style: none;
      padding: 0;
    }

    li {
      background-color: #e8e8e8;
      border: 0;
      border-radius: 5px;
      color: #313131;
      font-size: 12px;
      font-weight: bold;
      padding: 8px 18px;
      letter-spacing: 1px;
      margin-bottom: 5px;
      width: fit-content;
      float: left;
    }

    li:not(:last-child) {
      margin-right: 5px;
    }

    .flex-row {
      display: flex;
    }

    .flex-items--title {
      width: 25%;
    }

    .flex-items--content {
      width: 75%;
    }

    /* Style inputs with type="text", select elements and textareas */
    input[type=text],
    input[type=file],
    select,
    textarea {
      width: 100%;
      /* Full width */
      padding: 12px;
      /* Some padding */
      border: 1px solid #ccc;
      /* Gray border */
      border-radius: 4px;
      /* Rounded borders */
      box-sizing: border-box;
      /* Make sure that padding and width stays in place */
      margin-top: 6px;
      /* Add a top margin */
      margin-bottom: 16px;
      /* Bottom margin */
      resize: vertical
        /* Allow the user to vertically resize the textarea (not horizontally) */
    }

    /* When moving the mouse over the submit button, add a darker green color */
    input[type=submit]:hover {
      background-color: #45a049;
    }

    /* Add a background color and some padding around the form */
    .container {
      border-radius: 5px;
      padding: 20px;
    }

    .table-heading {
      align-content: center;
      padding-left: 45%;
      color: black;
    }

    .button-green {
      background-color: #04AA6D;
      color: white;
      padding: 12 px 20 px;
      border: none;
      border-radius: 4 px;
      cursor: pointer;
      font-size: 20px;
    }

    .button-green:hover {
      background-color: #45a049;
    }

    .button-black {
      background-color: #0f0f0fef;
      color: white;
      padding: 12 px 20 px;
      border: none;
      border-radius: 4 px;
      cursor: pointer;
      font-size: 20px;
    }

    .button-black:hover {
      background-color: #565c5c;
    }

    .tooltip {
      position: relative;
      display: inline-block;
    }

    .tooltip .tooltiptext {
      visibility: hidden;
      width: 600px;
      background-color: #45a049;
      color: #fff;
      text-align: center;
      border-radius: 6px;
      padding: 5px 0;

      /* Position the tooltip */
      position: absolute;
      z-index: 1;
      text-align: left;
      padding-left: 2px;
      margin-left: 2px;
    }

    .tooltip:hover .tooltiptext {
      visibility: visible;
      text-align: left;
      padding-left: 2px;
      margin-left: 2px;
    }

    .required-field {
      color: red;
    }

    .loader {
      width: 100%;
      height: 100vh;
      text-align: center;
      position: fixed;
      display: block !important;
    }

    .loader-image {
      width: 20vh;
      height: 20vh;
    }

    .editconfig-loading {
      visibility: hidden;
    }

    .error-input {
      border-color: indianred !important;
      border-width: revert !important;
    }

    .action-button {
      width: 25px;
      height: 26px;
    }

    .button-sm-red {
      background-color: #f12c12;
      color: white;
      padding: 12 px 20 px;
      border: none;
      border-radius: 4 px;
      cursor: pointer;
      font-size: 16px;
    }

    .button-sm-red:hover {
      background-color: #c44130;
    }

    .packages-tooltip {
      width: 525px !important;
      font-size: 18px !important;
    }

    .openin-tooltip {
      width: 670px !important;
      font-size: 18px !important;
    }

    .bindssl-tooltip {
      width: 530px !important;
      font-size: 18px !important;
    }

    .config-text {
      font-size: 20px;
    }

    .config-checkbox {
      width: 15px;
      height: 15px;
    }

    .start-on-boot-err {
      position: relative;
      display: inline-block;
      color: #eb1c0d;
      visibility: hidden;
    }

    .key-file-err {
      position: relative;
      display: inline-block;
      color: #eb1c0d;
      visibility: hidden;
    }

    .cert-file-err {
      position: relative;
      display: inline-block;
      color: #eb1c0d;
      visibility: hidden;
    }

    .ssl-text-box {
      width: 30% !important;
      height: 20px !important;
    }

    .hidden-ssl {
      visibility: hidden;
    }

    .bind-ssl {
      padding-left: 28px;
    }

    .ssl-text-content {
      font-size: 13px !important;
      padding-left: 2px;
    }

    .mac-boot-start-msg {
      display: none;
    }
  </style>
  <script type="text/javascript" language="JavaScript">
    function enableLoader(event) {
      if (event) {
        event.preventDefault();
      }
      let authPassword = document.getElementById("auth-password").value;
      let authOtp = document.getElementById("otp-code").value;
      
      if (authPassword && authOtp) {
        if (/^\d+$/.test(authOtp) && authOtp.length == 6) {
          document.getElementById('ndalogindiv').disabled = true;
          document.getElementById('ndaautherr').disabled = true;
          document.getElementById('loader-div').classList.add('loader');
        } else {
          alert("Auth OTP should contains only numbers and it should be of 6 digits.");
        }
      } else {
        alert("Please provide auth password & otp.");
      }
    }
  </script>
</head>

<body>
  <div id="loader-div" style="display: none;" class=""><br /><br /><br /><br /><br />
    <image class="loader-image" src="../images?name=loading.gif">
  </div>
  <div id="auth-page">
    <div class="table-heading">
      <h2 style="font-size: 50px;">Login</h2>
    </div>

    <div class="container" id="ndalogindiv">
      <form name="ndaloginform" style="text-align: center;" action="nda-login">
        <input type="text" style="width: 10% !important; border-color: black; font-size: 20px;" name="password"
        id="auth-password" required placeholder="Auth Password">
            <br /><br />
        <input type="text" style="width: 10% !important; border-color: black; font-size: 20px;" name="otp"
            id="otp-code" required placeholder="Auth OTP">
                <br /><br />
        <input type="submit" value="Login" class="button-green" style="height: 50px; width: 130px;" id="submit-button" onclick="enableLoader(event);">
      </form>
    </div>
    <div class="container" id="ndaautherr">
      <div style="align-content: center; text-align: center; border: 2px solid black; padding: 10px;">
        <p style="font-size: 40px;">Authentication not initialized. Please run <span style="color:red !important;">`nda setup-auth`</span> in your system terminal to initiate it.</p>
      </div>
    </div>
  </div>
</body>

</html>